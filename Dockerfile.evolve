# OpenEvolve runs in its own container, separate from the System1 backend.
FROM python:3.12-slim

WORKDIR /app/experiment
RUN pip install --no-cache-dir 'openevolve==0.4.0' 'fastapi==0.115.6' 'uvicorn==0.34.0'

COPY examples/openevolve_mcq_prompt/evolve_service.py ./
COPY examples/openevolve_mcq_prompt/server.py ./
COPY examples/openevolve_mcq_prompt/evaluator.py ./
COPY examples/openevolve_mcq_prompt/jev_evaluator.py ./
COPY examples/openevolve_mcq_prompt/config.yaml ./
COPY examples/openevolve_mcq_prompt/initial_prompt.txt ./

EXPOSE 3002
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "3002"]
